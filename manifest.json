{
  "manifest_version": 3,
  "name": "Short URL Saver",
  "version": "1.3",
  "description": "Simpan URL short dengan Ctrl+Alt+S dan ekspor ke TXT",
  
  "permissions": [
    "activeTab",
    "storage",
    "downloads"
  ],
  
  "background": {
    "scripts": ["background.js"]
  },
  
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png"
    }
  },
  
  "commands": {
    "simpan-url": {
      "suggested_key": {
        "default": "Ctrl+Alt+S"
      },
      "description": "Simpan URL tab aktif"
    }
  },
  
  "browser_specific_settings": {
    "gecko": {
      "id": "short-saver@example.com"
    }
  }
}